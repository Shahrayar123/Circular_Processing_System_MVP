# AuditPilot MVP — settings
#
# Copy this file to `.env` and edit. Every line is OPTIONAL: with no .env at all the
# demo runs on keyword rules with no model, which is the point of the defaults.
#
#     cp .env.example .env
#
# `.env` is gitignored. `.env.example` is committed, so the list of settings travels
# with the code and nobody has to read config.py to find out what can be configured.


# ====== WHICH ENGINE MAKES EACH JUDGEMENT ======
# Both default to "rules": no model, no network, same answer every run. Either can be
# switched independently — they are different stages, and it is worth being able to test
# the model on one without paying for it on the other.

# Does this clause create an obligation the bank can be audited against?
#   rules = keyword patterns, instant
#   llm   = a local model reads each clause  (equivalent to --judge llm)
MVP_JUDGE=rules

# What change does this obligation require — New, Amendment, Deletion, No action?
#   rules  = thresholds over the retrieval scores  (equivalent to --engine rules)
#   ollama = a local model decides                 (equivalent to --engine ollama)
MVP_ENGINE=rules

# The command line WINS over these. `--judge llm` overrides MVP_JUDGE=rules, so this file
# sets the normal behaviour and a flag is a one-off deviation from it.


# ====== THE LOCAL MODEL ======
# Only used when MVP_JUDGE=llm or MVP_ENGINE=ollama. Ollama must be running and the
# model already pulled:  ollama pull qwen2.5:7b
#
# Name it exactly as `ollama list` shows it, tag included. A missing tag or a model that
# was never pulled fails every attempt and the run falls back to the rules — correct
# behaviour, but it looks like the model disagreeing rather than the model being absent.
MVP_OLLAMA_MODEL=qwen2.5:7b
MVP_OLLAMA_URL=http://localhost:11434

# How many times a model call is attempted before the rules take over. A 7B model
# intermittently returns a truncated object or an array of the wrong length, and asking
# again usually works — the failure is a bad sample, not a bad prompt. Every attempt
# after the first is printed, so a run that retried never looks like one that did not.
MVP_LLM_ATTEMPTS=3

# Seconds to wait after a failed attempt, doubling each time (1s, then 2s).
MVP_LLM_RETRY_BACKOFF=1.0


# ====== NOTES ======
# The audit test library is generated, not configured — 500 synthetic tests from a fixed
# seed, so every machine builds an identical library. Embeddings are TF-IDF over that
# library and are not model-driven; changing MVP_OLLAMA_MODEL does not change them.
#
# Paths (Circulars Data/, RIA Emails/, output/, mvp_demo.db) are fixed relative to the
# MVP folder so the demo runs from anywhere. They are in config.py, not here, because
# moving them breaks the "clone and run" promise this demo exists to make.
